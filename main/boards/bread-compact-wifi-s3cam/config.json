{
  "type": "bread-compact-wifi-s3cam",
  "target": "esp32s3",
  "builds": [
    {
      "name": "bread-compact-wifi-s3cam",
      "build_options": {
        "camera_hmirror": false,
        "camera_vflip": false
      },
      "sdkconfig_append": [
        "CONFIG_LCD_ST7789_240X240=y",
        "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
        "CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32",
        "CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=48"
      ]
    }
  ]
}